{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend/"
    },
    "backend": {
      "root": "backend/",
      "framework": "fastapi",
      "entrypoint": "main:app"
    }
  },
  "rewrites": [
    {
      "source": "/shops/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/shops",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/items/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/meal-finder",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/reviews/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/analytics/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
